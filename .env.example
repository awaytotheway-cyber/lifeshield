# Copy this file to .env and fill in your real values.
# Never commit .env — it is git-ignored.
#
# For a standalone Android APK (EAS cloud build), also set the same EXPO_PUBLIC_*
# values as EAS secrets — see eas-build.md. The .env file is not sent to Expo's servers.

# Supabase (public keys — safe in the app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste_your_anon_public_key_here

# Stripe publishable key only (pk_test_… from Stripe Dashboard → API keys)
# The secret key (sk_test_…) goes in Supabase Edge Function secrets — never here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_paste_your_publishable_key_here

# Phase 5 feature flags. Set to "off" to hide a feature without a new release.
EXPO_PUBLIC_FEATURE_BOOKING=on
